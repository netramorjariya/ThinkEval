PORT=5000
NODE_ENV=development
# Local: mongodb://127.0.0.1:27017/thinkeval
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/thinkeval?retryWrites=true&w=majority&appName=<AppName>
# For Atlas, add your machine's IP (or 0.0.0.0/0 for open dev access) under Atlas > Network Access first.
MONGODB_URI=mongodb://127.0.0.1:27017/thinkeval
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CLIENT_URL=http://localhost:5173
MAX_FILE_SIZE_MB=25
